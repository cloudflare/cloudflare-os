    "./pptx": "./src/pptx.ts",
    "./pptx-slides": "./src/pptx-slides.ts",
    "./test-fixtures": "./__tests__/test-fixtures.ts",
    "./text": "./src/text.ts",
    "./xlsx-sheets": "./src/xlsx-sheets.ts",
