// Type-checks every library's `<name>/server.ts` -- the code that runs inside a gadget's Durable
// Object -- and the `<name>/src/**` modules it imports, under the Workers runtime types.
//
// Separate from `tsconfig.client.json` because the two gadget runtimes need different globals, and
// neither side's should leak into the other -- a Durable Object must not see `document`, and iframe
// code must not be able to import `cloudflare:workers`. The Workers types come from
// `@cloudflare/workers-types/experimental`, the way `gatekeeper-kit` gets them: this package has no
// wrangler config of its own to generate them from.
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    // A library's import of another (`gadgets:ui/client`) is external in its bundle and resolves
    // through the gadget's pins at load time; here it resolves to that library's entry in this tree.
    "paths": {
      "gadgets:*/client": ["./*/client.ts"],
      "gadgets:*/server": ["./*/server.ts"]
    },
    "types": ["@cloudflare/workers-types/experimental"],
    "noEmit": true
  },
  "files": [],
  "include": ["*/server.ts"]
}
