// Type-checks the browser side of every library: each `<name>/client.ts` and the `<name>/src/**`
// modules it imports, under the DOM lib the gadget iframe provides.
//
// Only the entry is listed, and tsc follows its imports from there, the same way
// `tsconfig.server.json` does for `<name>/server.ts`: a `src/` module is then checked under the
// globals of the side that imports it, and a module both sides import under both. That is the
// point of the split -- a client-only editor module may reach for `document` and a server-only
// module for `DurableObjectStorage`, and listing all of `src/` here would put the latter under the
// DOM program that has no Workers types. A `src/` module no entry imports is checked by the tests
// program alone, and the bundler has nothing to compile it into.
//
// This program declares no `types` at all, because a library module must not compile against Node
// globals it will not have in the iframe (the libraries' own tests are Node code and are checked
// by `tsconfig.tests.json`).
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Library modules import each other by on-disk name (`./src/blocks.ts`), the way esbuild
    // resolves them when it bundles them.
    "allowImportingTsExtensions": true,
    // A library's import of another (`gadgets:ui/client`) is external in its bundle and resolves
    // through the gadget's pins at load time; here it resolves to that library's entry in this tree.
    "paths": {
      "gadgets:*/client": ["./*/client.ts"],
      "gadgets:*/server": ["./*/server.ts"]
    },
    "types": [],
    "noEmit": true
  },
  "files": [],
  "include": ["*/client.ts"]
}
