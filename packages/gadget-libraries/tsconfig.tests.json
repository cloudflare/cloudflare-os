// Type-checks the unit tests each library keeps beside its sources (`<name>/__tests__/**`), and
// with them the `<name>/src/**` modules they import.
//
// Separate from `tsconfig.client.json` for one reason: a test is Node code and a gadget module is
// not. Tests load fixtures (`node:fs`) and run under vitest, so this program declares `node`
// types; the client program declares none, so a library module that reached for a Node global
// fails there even though its own test compiles.
//
// Vitest's own types come from the `vitest` import, and DOM is present because the tests run in
// jsdom by default (see vitest.config.ts). A server test mocks `cloudflare:workers` rather than
// importing the real one, so no Workers types are declared here.
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    // A library's import of another (`gadgets:ui/client`) is external in its bundle and resolves
    // through the gadget's pins at load time; here it resolves to that library's entry in this tree.
    "paths": {
      "gadgets:*/client": ["./*/client.ts"],
      "gadgets:*/server": ["./*/server.ts"]
    },
    "types": ["node"],
    "noEmit": true
  },
  "files": [],
  "include": ["*/__tests__/**/*.ts"]
}
