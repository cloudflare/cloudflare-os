// Type-checks each bundled format blueprint's `files/server.ts` -- the gadget's Durable Object --
// and the `files/lib/**/*.ts` modules it imports, under the Workers runtime types.
//
// A standalone program, not this package's own (`tsconfig.json`) plus the entries, and the reason
// is what a gadget's Durable Object is given at runtime: `{ GADGET, ...visibleBindings }`, never the
// backend's bindings. Under the generated `worker-configuration.d.ts` a bare `extends DurableObject`
// or `extends WorkerEntrypoint` types `this.env` as `Cloudflare.Env` -- the backend's KV, R2 and
// service bindings -- and `ctx.exports` as the backend's own classes, so a blueprint reaching for
// `this.env.BLUEPRINTS` would type-check against bindings it will never receive. Here the Workers
// types come from `@cloudflare/workers-types/experimental`, as `tsconfig.server.json` in
// packages/gadget-libraries gets them: `Cloudflare.Env` and `GlobalProps` are empty, so a bare
// class sees an empty environment and a blueprint that wants its bindings has to declare them
// (`DurableObject<GadgetEnv>`). That the generated file would also drag `src/` into the program,
// through `GlobalProps.mainModule`, is a second reason, not the first.
//
// The client side stays separate (`tsconfig.blueprints-client.json`): the two gadget runtimes need
// different globals, and neither side's should leak into the other -- a Durable Object must not see
// `document`, and iframe code must not be able to import `cloudflare:workers`.
//
// Only the entry is listed, not `lib/`: tsc follows imports, so a `lib/` module a server imports is
// checked here, while a DOM-touching editor module the server never reaches is checked only by the
// client program.
//
// `files: []` alongside `include`: a blueprint set with no TypeScript is a valid state (every
// blueprint may be plain JavaScript), and without it tsc reports "no inputs found" as an error.
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Blueprint modules import each other by on-disk name (`./lib/blocks.ts`), the way esbuild
    // resolves them when it bundles the archive.
    "allowImportingTsExtensions": true,
    // Each entry is bundled alone, so an entry with no import or export must still be a module here
    // rather than a global script sharing its declarations with another blueprint's.
    "moduleDetection": "force",
    // `gadgets:<name>/<side>` names a library in packages/gadget-libraries, which the build inlines
    // into the bundle (see scripts/format-blueprint-files.ts); tsc reads the same entry.
    "paths": { "gadgets:*": ["../gadget-libraries/*"] },
    "types": ["@cloudflare/workers-types/experimental"],
    "noEmit": true
  },
  "files": [],
  "include": ["format-blueprints/*/files/server.ts"]
}
