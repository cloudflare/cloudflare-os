{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "odie-os-backend",
  "main": ".wrangler/validate/src/server.ts",
  "build": {
    "command": "pnpm run build:worker",
    "watch_dir": "src"
  },
  "compatibility_date": "2026-02-02",
  "compatibility_flags": [
    "allow_irrevocable_stub_storage",
    "enhanced_error_serialization",
    "global_fetch_strictly_public",
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "ADMINS": [
      "jacob.beck@totango.com",
      "keith@totango.com",
      "nick.roberts@totango.com",
      "stacy.kennedy@totango.com"
    ],
    "AUTH_GATEKEEPERS": "google",
    "AUTH_EMAIL_DOMAIN_ALIASES": { "heyodie.ai": "totango.com" },
    "CF_ACCESS_AUD": "8201bdec886d2938927bd320749e9aaebf3562bf12286db06d788eaea49b2e21",
    "CF_ACCESS_ISS": "https://weathered-moon-e011.cloudflareaccess.com",
    "CF_AI_GATEWAY": "odie-os-ai",
    "CF_AI_GATEWAY_ACCOUNT_ID": "286469790a4362a2e194b32045c5eca7",
    "CODING_SESSION_PI_RUNTIME_ENABLED": "true",
    "DEFAULT_ENABLED_AMBIENT_GATEKEEPERS": "context,work-items",
    "DEPLOY_URL": "https://os.cloudflare.app/deploy/?instance=0b25cd3c-6772-4200-be89-353ceea1c63e",
    "PUBLIC_BASE_URL": "https://odie-os-native-api.odie-os.workers.dev",
    "DISABLE_PASSWORD_AUTH": "true",
    "REQUIRED_HEALTHY_CONNECTIONS": "odie_kg",
    "TEAM_PI_CODEX_ONLY": "true"
  },
  "browser": { "binding": "BROWSER" },
  "ai": { "binding": "WORKERS_AI" },
  "services": [
    { "binding": "GATEKEEPER_CONTEXT", "service": "odie-os-gk-context", "entrypoint": "GatekeeperVendor" },
    { "binding": "GATEKEEPER_GITHUB", "service": "odie-os-gk-github", "entrypoint": "GatekeeperVendor" },
    { "binding": "GATEKEEPER_GOOGLE", "service": "odie-os-gk-google", "entrypoint": "GatekeeperVendor" },
    { "binding": "GATEKEEPER_GITHUB_ORG", "service": "odie-os-gk-sessions", "entrypoint": "GitHubOrganizationVendor" },
    { "binding": "GATEKEEPER_JARVIS", "service": "odie-os-gk-jarvis", "entrypoint": "GatekeeperVendor" },
    { "binding": "GATEKEEPER_JIRA", "service": "odie-os-gk-jira", "entrypoint": "GatekeeperVendor" },
    { "binding": "GATEKEEPER_MCP", "service": "odie-os-gk-mcp", "entrypoint": "GatekeeperVendor" },
    { "binding": "GATEKEEPER_NOTION", "service": "odie-os-gk-notion", "entrypoint": "GatekeeperVendor" },
    { "binding": "GATEKEEPER_ODIE_KG", "service": "odie-os-gk-odie-kg", "entrypoint": "GatekeeperVendor" },
    { "binding": "GATEKEEPER_SCHEDULER", "service": "odie-os-gk-scheduler", "entrypoint": "GatekeeperVendor" },
    { "binding": "GATEKEEPER_SESSIONS", "service": "odie-os-gk-sessions", "entrypoint": "GatekeeperVendor" },
    { "binding": "GATEKEEPER_SLACK", "service": "odie-os-gk-slack", "entrypoint": "GatekeeperVendor" },
    { "binding": "GATEKEEPER_WORK_ITEMS", "service": "odie-os-gk-work-items", "entrypoint": "GatekeeperVendor" },
    { "binding": "GATEKEEPER_ZENDESK", "service": "odie-os-gk-zendesk", "entrypoint": "GatekeeperVendor" }
  ],
  "migrations": [
    { "tag": "v0", "new_sqlite_classes": ["UserDurableObject", "OverseerDurableObject"] },
    { "tag": "v1", "new_sqlite_classes": ["AdminSettings"] },
    { "tag": "v2", "new_sqlite_classes": ["PendingLogin"] },
    // Preserve the tag applied by the production-native gateway rollout.
    { "tag": "v3" }
  ],
  "kv_namespaces": [
    { "binding": "BLUEPRINTS", "id": "882e6c6dfdf9466f999b8084ed3cd637" },
    { "binding": "AVATARS", "id": "7147e3e3dc964b03b85f00f62952c92e" }
  ],
  "r2_buckets": [
    { "binding": "BLUEPRINT_CONTENT", "bucket_name": "odie-os-blueprint-content" }
  ],
  "worker_loaders": [{ "binding": "LOADER" }],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  }
}
