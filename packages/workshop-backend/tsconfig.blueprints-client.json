// Type-checks the browser side of the bundled format blueprints: each `files/client.ts` and the
// `files/lib/**/*.ts` modules it imports, under the DOM lib the gadget iframe provides. Run by the
// `build` task in vite.config.ts.
//
// Only the entry is listed, and tsc follows its imports from there, the same way
// `tsconfig.blueprints-server.json` does for `files/server.ts`: a `lib/` module is then checked
// under the globals of the side that imports it, and a module both sides import under both. That
// is the point of the split -- a client-only editor module may reach for `document` and a
// server-only module for `DurableObjectStorage`, and listing all of `lib/` here would put the
// latter under the DOM program that has no Workers types. Nothing is lost by not listing it: a
// `lib/` module no entry imports fails the build in the bundler, which has nothing to compile it
// into.
//
// This program declares no `types` at all, because a gadget module must not compile against Node
// globals it will not have in the iframe (the blueprints' own tests are Node code and are checked
// by `tsconfig.blueprints-tests.json`).
//
// `files: []` alongside `include`: a blueprint set with no TypeScript is a valid state (every
// blueprint may be plain JavaScript), and without it tsc reports "no inputs found" as an error.
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Blueprint modules import each other by on-disk name (`./lib/blocks.ts`), the way esbuild
    // resolves them when it bundles the archive.
    "allowImportingTsExtensions": true,
    "types": [],
    "noEmit": true
  },
  "files": [],
  "include": ["format-blueprints/*/files/client.ts"]
}
