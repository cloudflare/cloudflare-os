            {
              "name": "collectionId",
              "type": {
                "kind": "string"
              },
              "optional": false,
              "doc": ""
            },
            {
              "name": "options",
              "type": {
                "kind": "object",
                "properties": {
                  "branch": {
                    "kind": "union",
                    "branches": [
                      {
                        "kind": "string"
