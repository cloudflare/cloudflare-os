  },
  "shapes": {
    "ContextCollectionContent": {
      "kind": "union",
      "branches": [
        {
          "kind": "object",
          "properties": {
            "branch": {
              "kind": "string"
            },
            "commit": {
              "kind": "union",
              "branches": [
                {
                  "kind": "string"
                },
                {
                  "kind": "undefined"
                }
              ]
            },
            "lastRefreshedAt": {
              "kind": "date"
            },
            "remote": {
              "kind": "string"
            },
            "source": {
              "kind": "literal",
              "value": "git"
            }
          }
        },
        {
          "kind": "object",
          "properties": {
            "source": {
              "kind": "literal",
              "value": "web"
            }
          }
        }
      ]
    },
    "ContextCollectionMember": {
      "doc": "One account holding a role on a private collection.",
      "kind": "object",
      "properties": {
        "displayName": {
          "kind": "union",
          "branches": [
            {
              "kind": "string"
            },
            {
              "kind": "undefined"
            }
          ]
        },
        "isViewer": {
          "kind": "boolean"
        },
        "memberId": {
          "kind": "string"
        },
        "role": {
          "kind": "ref",
          "name": "ContextCollectionRole"
        }
      },
      "propertyDocs": {
        "displayName": {
          "doc": "The Workshop display name snapshotted when they were added. Absent for the account that\ncreated the collection before sharing existed. Presentation only."
        },
        "isViewer": {
          "doc": "Whether this member is the viewing account."
        },
        "memberId": {
          "doc": "Opaque member identifier, passed back to change or remove this member's role."
        }
      }
    },
    "ContextCollectionMetadata": {
      "kind": "object",
      "properties": {
        "content": {
          "kind": "ref",
          "name": "ContextCollectionContent"
        },
        "created": {
          "kind": "date"
        },
        "description": {
          "kind": "string"
        },
        "documentCount": {
          "kind": "number"
        },
        "icon": {
          "kind": "union",
          "branches": [
            {
              "kind": "string"
            },
            {
              "kind": "undefined"
            }
          ]
        },
        "id": {
          "kind": "string"
        },
        "lastUpdated": {
          "kind": "date"
        },
        "title": {
          "kind": "string"
        },
        "visibility": {
          "kind": "ref",
          "name": "ContextCollectionVisibility"
        }
      },
      "propertyDocs": {
        "description": {
          "doc": "Listed and used by agents to decide relevance."
        },
        "documentCount": {
          "doc": "Number of documents in this collection."
        },
        "icon": {
          "doc": "Optional emoji icon."
        },
        "id": {
          "doc": "Random hex ID."
        },
        "title": {
          "doc": "Human-readable title."
        }
      }
    },
    "ContextCollectionPermissions": {
      "doc": "What the viewing account may do with one collection.",
      "kind": "object",
      "properties": {
        "canDelete": {
          "kind": "boolean"
        },
        "canEdit": {
          "kind": "boolean"
        },
        "canManageOwners": {
          "kind": "boolean"
        },
        "canShare": {
          "kind": "boolean"
        }
      },
      "propertyDocs": {
        "canDelete": {
          "doc": "Delete the whole collection."
        },
        "canEdit": {
          "doc": "Edit web-managed content and collection details, and manage git mirroring. On a private\ncollection, also share it as viewer or editor and toggle everyone-viewable."
        },
        "canManageOwners": {
          "doc": "Grant `owner`, and demote or remove owners."
        },
        "canShare": {
          "doc": "Open the Share dialog: an editable private collection."
        }
      }
    },
    "ContextCollectionRole": {
      "doc": "An account's role on a private collection. Every role reads all of its content; see\nContextCollectionPermissions for what each may change.",
      "kind": "union",
      "branches": [
        {
          "kind": "literal",
          "value": "editor"
        },
        {
          "kind": "literal",
          "value": "owner"
        },
        {
          "kind": "literal",
          "value": "viewer"
        }
      ]
    },
    "ContextCollectionSharing": {
      "doc": "A private collection's sharing state.",
      "kind": "object",
      "properties": {
        "everyoneCanView": {
          "kind": "boolean"
        },
        "hasOwner": {
          "kind": "boolean"
        },
        "members": {
          "kind": "array",
          "element": {
            "kind": "ref",
            "name": "ContextCollectionMember"
          }
        }
      },
      "propertyDocs": {
        "everyoneCanView": {
          "doc": "Every account in the sharing domain may read it, without it appearing in their library."
        },
        "hasOwner": {
          "doc": "False once the last owner's account was disconnected while others still held access."
        }
      }
    },
    "ContextCollectionVisibility": {
      "doc": "Collection visibility within a sharing domain, which says who can read a collection: `private`,\nits members (see ContextApi.shareContextCollection()), or every account in the domain when its\n`everyoneCanView` is set (see ContextApi.setContextCollectionEveryoneCanView()); or `public`,\neveryone, which only deployment admins may create or edit.",
      "kind": "union",
      "branches": [
        {
          "kind": "literal",
          "value": "private"
        },
        {
          "kind": "literal",
          "value": "public"
        }
      ]
    },
    "ContextDocument": {
      "doc": "Stored document. Text bodies are literal text; binary bodies are base64 without a data: prefix.",
      "kind": "object",
      "properties": {
        "body": {
          "kind": "string"
        },
        "contentType": {
          "kind": "string"
        },
        "description": {
          "kind": "string"
        },
        "lastUpdated": {
          "kind": "date"
        },
        "name": {
          "kind": "string"
        },
        "path": {
          "kind": "string"
        },
        "skillName": {
          "kind": "union",
          "branches": [
            {
              "kind": "string"
            },
            {
              "kind": "undefined"
            }
          ]
        }
      },
      "propertyDocs": {
        "body": {
          "doc": "Literal text for text content types; base64 for binary ones."
        },
        "contentType": {
          "doc": "Determines whether `body` is text or base64."
        },
        "description": {
          "doc": "What this document covers and when to use it. Values over 16,000 characters are truncated."
        },
        "name": {
          "doc": "File name derived from the path."
        },
        "path": {
          "doc": "Primary key within the collection, using \"/\" separators."
        },
        "skillName": {
          "doc": "Set when this document is a valid skill."
        }
      }
    },
    "ContextDocumentSummary": {
      "doc": "Document info without body.",
      "kind": "object",
      "properties": {
        "contentType": {
          "kind": "string"
        },
        "description": {
          "kind": "string"
        },
        "lastUpdated": {
          "kind": "date"
        },
