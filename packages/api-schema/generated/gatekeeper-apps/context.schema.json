{
  "format": "capnweb-schema/1",
  "entry": "ContextApi",
  "constants": {},
  "services": {
    "ContextApi": {
      "doc": "Per-account management API exposed to the gatekeeper app iframe.",
      "direction": "server",
      "methods": [
        {
          "name": "createContextCollection",
          "doc": "Creates a collection this account owns. `description` is what agents read to decide whether it\nis relevant; `icon` is an emoji. `source` is `\"web\"` (the default: its documents are written\nthrough this API) or `\"git\"`, a Git repository reached with a token from\ncreateContextCollectionGitToken(), where getViewerInfo() says the deployment supports it.",
          "params": [
            {
              "name": "title",
              "type": {
                "kind": "string"
              },
              "optional": false,
              "doc": ""
            },
            {
              "name": "description",
              "type": {
                "kind": "string"
              },
              "optional": false,
              "doc": ""
            },
            {
              "name": "visibility",
              "type": {
                "kind": "ref",
                "name": "ContextCollectionVisibility"
              },
              "optional": false,
              "doc": ""
            },
            {
              "name": "icon",
              "type": {
                "kind": "string"
              },
              "optional": true,
              "doc": ""
            },
            {
              "name": "source",
              "type": {
                "kind": "union",
                "branches": [
                  {
                    "kind": "literal",
                    "value": "git"
                  },
                  {
                    "kind": "literal",
                    "value": "web"
                  }
                ]
              },
              "optional": true,
              "doc": ""
            }
          ],
          "returns": {
            "kind": "ref",
            "name": "ContextCollectionMetadata"
          }
        },
        {
          "name": "createContextCollectionGitToken",
          "doc": "",
          "params": [
            {
              "name": "collectionId",
              "type": {
                "kind": "string"
              },
              "optional": false,
              "doc": ""
            }
          ],
          "returns": {
            "kind": "ref",
            "name": "ContextGitTokenCreateResult"
          }
        },
        {
          "name": "createContextSkill",
          "doc": "Creates a skill, rejecting the operation if its directory is already occupied. `path` is the\nskill's manifest, a file named SKILL.md in a new directory: `my-skill/SKILL.md`, or\n`tools/my-skill/SKILL.md` in an existing directory that is not inside another skill.\n\n`doc.body` is the manifest's text. It starts with YAML frontmatter between two `---` lines,\nholding `name` (at most 64 characters of lowercase letters, digits and single hyphens:\n`my-skill`) and `description` (1 to 1024 characters: what the skill does and when to use it);\nthe instructions follow it. `doc.description` describes the document in listings, as for any\ndocument. Supporting files go in the skill's directory, written with putContextDocument().",
          "params": [
            {
              "name": "collectionId",
              "type": {
                "kind": "string"
              },
              "optional": false,
              "doc": ""
            },
            {
              "name": "path",
              "type": {
                "kind": "string"
              },
              "optional": false,
              "doc": ""
            },
            {
              "name": "doc",
              "type": {
                "kind": "object",
                "properties": {
                  "body": {
                    "kind": "string"
                  },
                  "contentType": {
                    "kind": "union",
                    "branches": [
                      {
                        "kind": "string"
                      },
                      {
                        "kind": "undefined"
                      }
                    ]
                  },
                  "description": {
                    "kind": "string"
                  }
                }
              },
              "optional": false,
              "doc": ""
            }
          ],
          "returns": {
            "kind": "void"
          }
        },
        {
          "name": "deleteContextCollection",
          "doc": "",
          "params": [
            {
              "name": "collectionId",
              "type": {
                "kind": "string"
              },
              "optional": false,
              "doc": ""
            }
          ],
          "returns": {
            "kind": "void"
          }
        },
        {
          "name": "deleteContextDocument",
          "doc": "",
          "params": [
            {
              "name": "collectionId",
              "type": {
                "kind": "string"
              },
              "optional": false,
              "doc": ""
            },
            {
              "name": "path",
              "type": {
                "kind": "string"
              },
              "optional": false,
              "doc": ""
            }
          ],
          "returns": {
            "kind": "void"
          }
        },
        {
          "name": "deleteContextDocumentTree",
          "doc": "Atomically deletes a document path and every document below it.",
          "params": [
            {
              "name": "collectionId",
              "type": {
                "kind": "string"
              },
              "optional": false,
              "doc": ""
            },
            {
              "name": "path",
              "type": {
                "kind": "string"
              },
              "optional": false,
              "doc": ""
            }
          ],
          "returns": {
            "kind": "void"
          }
        },
        {
          "name": "deleteContextSkill",
          "doc": "Atomically deletes a skill and its supporting files.",
          "params": [
            {
              "name": "collectionId",
              "type": {
                "kind": "string"
              },
              "optional": false,
              "doc": ""
            },
            {
              "name": "manifestPath",
              "type": {
                "kind": "string"
              },
              "optional": false,
              "doc": ""
            }
          ],
          "returns": {
            "kind": "void"
          }
        },
        {
          "name": "getContextCollectionMetadata",
          "doc": "",
          "params": [
            {
              "name": "collectionId",
              "type": {
                "kind": "string"
              },
              "optional": false,
              "doc": ""
            }
          ],
          "returns": {
            "kind": "union",
            "branches": [
              {
                "kind": "null"
              },
              {
                "kind": "ref",
                "name": "ContextCollectionMetadata"
              }
            ]
          }
        },
        {
          "name": "getContextCollectionPermissions",
          "doc": "What the viewer may do with a collection it can read.",
          "params": [
            {
              "name": "collectionId",
              "type": {
                "kind": "string"
              },
              "optional": false,
              "doc": ""
            }
          ],
          "returns": {
            "kind": "ref",
            "name": "ContextCollectionPermissions"
          }
        },
        {
          "name": "getContextCollectionSharing",
          "doc": "Members and everyone-viewability of a collection the viewer can read.",
          "params": [
            {
              "name": "collectionId",
              "type": {
                "kind": "string"
              },
              "optional": false,
              "doc": ""
            }
          ],
          "returns": {
            "kind": "ref",
            "name": "ContextCollectionSharing"
          }
        },
        {
          "name": "getContextDocument",
          "doc": "",
          "params": [
            {
              "name": "collectionId",
              "type": {
                "kind": "string"
              },
              "optional": false,
              "doc": ""
            },
            {
              "name": "path",
              "type": {
                "kind": "string"
              },
              "optional": false,
              "doc": ""
            }
          ],
          "returns": {
            "kind": "union",
            "branches": [
              {
                "kind": "null"
              },
              {
                "kind": "ref",
                "name": "ContextDocument"
              }
            ]
          }
        },
        {
          "name": "getViewerInfo",
          "doc": "Gates creating/editing public collections and offering Git-backed collections.",
          "params": [],
          "returns": {
            "kind": "object",
            "properties": {
              "isAdmin": {
                "kind": "boolean"
              },
              "supportsGitCollections": {
                "kind": "boolean"
              }
            }
          }
        },
        {
          "name": "leaveContextCollection",
          "doc": "Give up the viewer's own role, whatever it is; the last owner cannot leave.",
          "params": [
            {
              "name": "collectionId",
              "type": {
                "kind": "string"
              },
              "optional": false,
              "doc": ""
            }
          ],
          "returns": {
            "kind": "void"
          }
        },
        {
          "name": "listContextCollectionGitTokens",
          "doc": "",
