            "kind": "ref",
            "name": "ContextGitTokenList"
          }
        },
        {
          "name": "listContextDocuments",
          "doc": "",
          "params": [
            {
              "name": "collectionId",
              "type": {
                "kind": "string"
              },
              "optional": false,
              "doc": ""
            },
            {
              "name": "prefix",
              "type": {
                "kind": "string"
              },
              "optional": true,
              "doc": ""
            }
          ],
          "returns": {
            "kind": "array",
            "element": {
              "kind": "ref",
              "name": "ContextDocumentSummary"
            }
          }
        },
        {
          "name": "listEnabledContextCollections",
          "doc": "Collections this account holds a role on, plus every public one.",
          "params": [],
          "returns": {
            "kind": "array",
            "element": {
              "kind": "ref",
              "name": "EnabledCollectionInfo"
            }
          }
        },
        {
          "name": "moveContextDocument",
          "doc": "",
          "params": [
            {
              "name": "collectionId",
              "type": {
                "kind": "string"
              },
              "optional": false,
              "doc": ""
            },
            {
              "name": "fromPath",
              "type": {
                "kind": "string"
              },
              "optional": false,
              "doc": ""
            },
            {
              "name": "toPath",
              "type": {
                "kind": "string"
              },
              "optional": false,
              "doc": ""
            }
          ],
          "returns": {
            "kind": "void"
          }
        },
        {
          "name": "moveContextSkill",
          "doc": "Atomically moves a skill and its supporting files within its collection.",
          "params": [
            {
              "name": "collectionId",
              "type": {
                "kind": "string"
              },
              "optional": false,
              "doc": ""
            },
            {
              "name": "manifestPath",
              "type": {
                "kind": "string"
              },
              "optional": false,
              "doc": ""
            },
            {
              "name": "directoryPath",
              "type": {
                "kind": "string"
              },
              "optional": false,
              "doc": ""
            }
          ],
          "returns": {
            "kind": "void"
          }
        },
        {
          "name": "putContextDocument",
          "doc": "The document's display name is always derived from its path (the file name), so it's not passed.",
          "params": [
            {
              "name": "collectionId",
              "type": {
                "kind": "string"
              },
              "optional": false,
              "doc": ""
            },
            {
              "name": "path",
              "type": {
                "kind": "string"
              },
              "optional": false,
              "doc": ""
            },
            {
              "name": "doc",
              "type": {
                "kind": "object",
                "properties": {
                  "body": {
                    "kind": "string"
                  },
                  "contentType": {
                    "kind": "union",
                    "branches": [
                      {
                        "kind": "string"
                      },
                      {
                        "kind": "undefined"
                      }
                    ]
                  },
                  "description": {
                    "kind": "string"
                  }
                }
              },
              "optional": false,
              "doc": ""
            }
          ],
          "returns": {
            "kind": "void"
          }
        },
        {
          "name": "removeContextCollectionMember",
          "doc": "Remove a member; removing the viewer's own membership leaves the collection.",
          "params": [
            {
              "name": "collectionId",
              "type": {
                "kind": "string"
              },
              "optional": false,
              "doc": ""
            },
            {
              "name": "memberId",
              "type": {
                "kind": "string"
              },
              "optional": false,
              "doc": ""
            }
          ],
          "returns": {
            "kind": "void"
          }
        },
        {
          "name": "renameContextSkill",
          "doc": "Atomically renames a skill directory and its manifest name.",
          "params": [
            {
              "name": "collectionId",
              "type": {
                "kind": "string"
              },
              "optional": false,
              "doc": ""
            },
            {
              "name": "manifestPath",
              "type": {
                "kind": "string"
              },
              "optional": false,
              "doc": ""
            },
            {
              "name": "newName",
              "type": {
                "kind": "string"
              },
              "optional": false,
              "doc": ""
            }
          ],
          "returns": {
            "kind": "void"
          }
        },
        {
          "name": "revokeContextCollectionGitToken",
          "doc": "",
          "params": [
            {
              "name": "collectionId",
              "type": {
                "kind": "string"
              },
              "optional": false,
              "doc": ""
            },
            {
              "name": "tokenId",
              "type": {
                "kind": "string"
              },
              "optional": false,
              "doc": ""
            }
          ],
          "returns": {
            "kind": "boolean"
          }
        },
        {
          "name": "setContextCollectionEveryoneCanView",
          "doc": "",
          "params": [
            {
              "name": "collectionId",
              "type": {
                "kind": "string"
              },
              "optional": false,
              "doc": ""
            },
            {
              "name": "everyoneCanView",
              "type": {
                "kind": "boolean"
              },
              "optional": false,
              "doc": ""
            }
          ],
          "returns": {
            "kind": "void"
          }
        },
        {
          "name": "setContextCollectionMemberRole",
          "doc": "",
          "params": [
            {
              "name": "collectionId",
              "type": {
                "kind": "string"
              },
              "optional": false,
              "doc": ""
            },
            {
              "name": "memberId",
              "type": {
                "kind": "string"
              },
              "optional": false,
              "doc": ""
            },
            {
              "name": "role",
              "type": {
                "kind": "ref",
