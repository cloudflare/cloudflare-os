        {
          "name": "shareContextCollection",
          "doc": "Share with the person a Workshop user-picker ticket names. Resolves once the share is durable;\nrejects with a message meant for display beside that person.",
          "params": [
            {
              "name": "collectionId",
              "type": {
                "kind": "string"
              },
              "optional": false,
              "doc": ""
            },
            {
              "name": "ticket",
              "type": {
                "kind": "string"
              },
              "optional": false,
              "doc": ""
            },
            {
              "name": "role",
              "type": {
                "kind": "ref",
                "name": "ContextCollectionRole"
              },
              "optional": false,
              "doc": ""
            }
          ],
          "returns": {
            "kind": "void"
          }
        },
        {
          "name": "syncContextCollectionArtifactSource",
          "doc": "",
          "params": [
            {
              "name": "collectionId",
              "type": {
                "kind": "string"
              },
              "optional": false,
              "doc": ""
            }
          ],
          "returns": {
            "kind": "void"
          }
        },
        {
          "name": "updateContextCollection",
          "doc": "",
