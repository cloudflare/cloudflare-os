// Generated from cloudflare.config.ts by scripts/generate-worker-configs.ts -- do not edit.
// Change cloudflare.config.ts and run `pnpm configs:generate`.
{
  "name": "gatekeeper-microsoft",
  "main": ".wrangler/validate/src/microsoft.ts",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": [
    "allow_irrevocable_stub_storage",
    "nodejs_als"
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "invocation_logs": false
    }
  },
  "ai": {
    "binding": "AI"
  },
  "build": {
    "command": "pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": "src"
  },
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.txt",
        "**/*.svg"
      ],
      "fallthrough": false
    }
  ],
  "migrations": [
    {
      "tag": "v0",
      "new_sqlite_classes": [
        "UserAccount",
        "SharePointGatekeeper",
        "OutlookGatekeeper",
        "OutlookHookDriver",
        "CalendarGatekeeper"
      ]
    }
  ]
}
