// Generated from cloudflare.config.ts by scripts/generate-worker-configs.ts -- do not edit.
// Change cloudflare.config.ts and run `pnpm configs:generate`.
{
  "name": "pdf-renderer",
  "main": ".wrangler/validate/src/worker.ts",
  "compatibility_date": "2026-09-04",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "invocation_logs": false
    }
  },
  "build": {
    "command": "pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": "src"
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ],
      "fallthrough": false
    },
    {
      "type": "Text",
      "globs": [
        "**/*.txt"
      ],
      "fallthrough": false
    }
  ]
}
