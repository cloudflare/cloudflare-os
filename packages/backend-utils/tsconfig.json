{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types/experimental", "./src/node-async-hooks.d.ts"],
    "outDir": "./dist",
    "declaration": true,
    "sourceMap": true,
    "noEmit": false,
