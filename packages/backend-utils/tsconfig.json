{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types/experimental", "./src/node-async-hooks.d.ts"]
  },
  // The tests (including the type-level assertions in __tests__/type-tests.ts) are checked by this
  // one project: with nothing emitted there is no reason to keep them in a separate config.
  "include": ["src", "__tests__/*.ts"],
  "exclude": ["node_modules"]
}
