{
  "name": "@gadgets/slack-gatekeeper",
  "version": "1.0.0",
  "type": "module",
  "main": "./src/slack.ts",
  "scripts": {
    "test:run": "vp run -F @gadgets/slack-gatekeeper build:configurator && vitest run && vitest run -c vitest.worker.config.ts",
    "dev": "echo \"run 'pnpm dev-server' in the root directory instead\" >&2 && exit 1",
    "deploy": "vp run --no-cache build:configurator && wrangler deploy",
    "clean": "rm -rf dist src/generated"
  },
  "dependencies": {
    "@gadgets/configurator-ui": "workspace:*",
    "@gadgets/gatekeeper-kit": "workspace:*",
    "@gadgets/workshop-shared": "workspace:*",
    "capnweb": "catalog:",
    "capnweb-validate": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "catalog:",
    "@gadgets/scripts": "workspace:*",
    "miniflare": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
