{
  "name": "gatekeeper-slack",
  "main": ".wrangler/validate/src/slack.ts",
  "build": {
    "command": "pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": "src"
  },
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["allow_irrevocable_stub_storage"],
  "rules": [
    { "type": "Text", "globs": ["**/*.txt", "**/*.svg"], "fallthrough": false }
  ],
  "migrations": [
    {
      "tag": "v0",
      "new_sqlite_classes": [
        "UserAccount",
        "SlackWorkspaceGatekeeperImpl",
        "SlackConversationGatekeeperImpl",
        "SlackThreadGatekeeperImpl"
      ]
    }
  ]
}
