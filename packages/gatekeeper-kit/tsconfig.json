{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types/experimental"],
    "paths": {
      "@gadgets/backend-utils/*": ["../backend-utils/src/*"],
      "@gadgets/workshop-shared/*": ["../workshop-shared/src/*"]
