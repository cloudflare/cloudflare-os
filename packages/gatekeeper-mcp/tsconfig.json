{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react",
    "jsxFactory": "h",
    "types": ["./worker-configuration.d.ts"],
    "baseUrl": ".",
    "paths": {
      "@gadgets/configurator-ui": ["../configurator-ui/src/index.ts"],
      "@gadgets/mcp-shared/*": ["../mcp-shared/src/*"],
      "@gadgets/workshop-shared/*": ["../workshop-shared/src/*"]
    }
  },
  // The tests are checked by this one project: with nothing emitted there is no reason to keep
  // them in a separate config.
  "include": ["src", "__tests__"],
  "exclude": ["node_modules"]
}
