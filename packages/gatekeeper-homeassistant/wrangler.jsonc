{
  "name": "gatekeeper-homeassistant",
  "main": ".wrangler/validate/src/homeassistant.ts",
  "build": {
    "command": "pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": "src"
  },
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["allow_irrevocable_stub_storage"],
  "migrations": [
    {
      "tag": "v0",
      "new_sqlite_classes": ["UserAccount", "HomeAssistantGatekeeperImpl"]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  }

}
