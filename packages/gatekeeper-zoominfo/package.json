    "test:run": "vp run -F @gadgets/zoominfo-gatekeeper build:configurator && vitest run"
  },
  "dependencies": {
    "@gadgets/configurator-ui": "workspace:*",
    "@gadgets/gatekeeper-kit": "workspace:*",
    "@gadgets/observability": "workspace:*",
    "@gadgets/workshop-shared": "workspace:*",
    "capnweb": "catalog:",
    "capnweb-validate": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "catalog:",
    "@gadgets/scripts": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
