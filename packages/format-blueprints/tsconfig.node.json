// Type-checks the build (`src/`) and its tests (`__tests__/`) as the Node programs they are.
//
// Nothing here is compiled: the Workshop backend's `scripts/build-format-blueprints.ts` and
// `scripts/import-format-blueprint.ts` import `src/` and run directly under `node`, which strips
// the types. `erasableSyntaxOnly` is what keeps that a guarantee, and `nodenext` resolution is
// what `node` actually does with the imports, so a specifier that only a bundler could resolve
// fails here rather than at the command line. Same settings as the repo's `scripts/tsconfig.json`,
// for the same reason.
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "__tests__/**/*.ts"]
}
