{
  "name": "@gadgets/gatekeeper-scheduler",
  "version": "1.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "echo \"run 'pnpm dev-server' in the root directory instead\" >&2 && exit 1",
    "deploy": "pnpm run build:app && wrangler deploy",
    "build:app": "node build-app.mjs",
    "build:app:watch": "node build-app.mjs --watch",
    "typecheck:app": "tsc -p tsconfig.app.json && tsc -p tsconfig.vite.json",
    "build": "pnpm run typecheck:app && pnpm run build:app && tsc",
    "types:check": "pnpm run typecheck:app && pnpm run build:app && tsc --noEmit",
    "test": "vp test run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@gadgets/backend-utils": "workspace:*",
    "@gadgets/error-reporting": "workspace:*",
    "@gadgets/workshop-shared": "workspace:*",
    "capnweb": "^0.8.0",
    "capnweb-validate": "0.2.1",
    "temporal-polyfill": "1.0.2"
  },
  "devDependencies": {
    "@cloudflare/kumo": "^2.9.0",
    "@cloudflare/vitest-pool-workers": "^0.16.20",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "miniflare": "4.20260625.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "terser": "^5.48.0",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plugin-singlefile": "^2.3.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "catalog:"
  }
}
