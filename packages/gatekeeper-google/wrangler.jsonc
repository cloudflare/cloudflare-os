{
  "name": "gatekeeper-google",
  "main": ".wrangler/validate/src/google.ts",
  "build": {
    "command": "pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": "src"
  },
  "compatibility_date": "2026-02-02",
  "compatibility_flags": ["allow_irrevocable_stub_storage", "nodejs_als"],
  "rules": [
    { "type": "Text", "globs": ["**/*.txt", "**/*.svg"], "fallthrough": false }
  ],
  "migrations": [
    {
      "tag": "v0",
      "new_sqlite_classes": [ "UserAccount", "GmailGatekeeperImpl" ]
    },
    {
      "tag": "v1",
      "new_sqlite_classes": [ "BigQueryGatekeeperImpl" ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [ "GoogleCalendarGatekeeperImpl" ]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": [ "GoogleSheetsGatekeeperImpl" ]
    }
  ],
  "vars": {
    // Set to "true" to offer the "BigQuery Public Data" connection, which queries Google's public
    // datasets (bigquery-public-data and friends) billed to a project the user picks. Off by
    // default: a deployment should opt in to a new data source rather than acquire one from a repo
    // update, and the queries cost the user money. `pnpm dev-server` turns it on for local
    // development.
    "ENABLE_BIGQUERY_PUBLIC_DATA": "false"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  }

}
