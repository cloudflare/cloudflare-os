# Dependencies
node_modules/

# Build outputs
dist/
# Generated gatekeeper UI bundles, rebuilt as a prerequisite of build/types:check/deploy
packages/gatekeeper-*/src/generated/*-configurator-ui.txt
packages/gatekeeper-*/src/generated/*-configurator-ui.js*
packages/gatekeeper-*/src/generated/app.txt
# Bundled format blueprints (regenerated at build time from FORMAT_BLUEPRINTS_DIR).
packages/workshop-backend/src/generated/format-blueprints.ts
packages/workshop-backend/src/generated/browser-export-runtime.txt

# TypeScript build info
*.tsbuildinfo

# run-local build cache stamp
.run-local-stamp

# Cloudflare Workers
.wrangler/
.env

# Local dev secrets (loaded by run-dev-server.js)
.dev.vars*

# Site-specific deployment configs.
wrangler.prod.jsonc
wrangler.staging.jsonc

# Site-specific dev server configs.
wrangler.dev.jsonc

# macOS
.DS_Store

# Wrangler local dev secrets (never commit). Matches root and per-package .dev.vars files.
.dev.vars
.dev.vars.*
**/.dev.vars
**/.dev.vars.*

# Per-developer tooling caches and configs (rtk, etc). Machine-local, not project state.
.rtk/

# Per-developer agent instructions. The project's tracked instructions live in AGENTS.md
# (upstream renamed CLAUDE.md -> AGENTS.md in 87e0163); a local CLAUDE.md is a personal copy,
# typically with individual workflow and tooling sections appended. Keep it out of the repo.
CLAUDE.md

# workerd DO storage created by fieldos-runtime tests
packages/fieldos-runtime/__tests__/fixture/dodata/
